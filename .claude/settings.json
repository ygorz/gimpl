{
  "permissions": {
    "deny": [
      "Read(./.memory/reference/lessons/**)",
      "Edit(./.memory/reference/lessons/**)",
      "Read(./.memory/storage.db*)",
      "Edit(./.memory/storage.db*)",
      "Read(./.memory/storage-audit.log)",
      "Edit(./.memory/storage-audit.log)",
      "Read(//memory/**)",
      "Edit(//memory/**)",
      "Bash(sqlite3 *)",
      "Read(./.eval-artifacts/**)",
      "Edit(./.eval-artifacts/**)",
      "Read(./docs/holdout-task-set.md)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/memory-secret-guard.py"
          }
        ]
      },
      {
        "matcher": "Bash|Read|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/orchestrator-bash-guard.py",
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
